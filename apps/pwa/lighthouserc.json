{
  "ci": {
    "collect": {
      "staticDistDir": "./dist",
      "numberOfRuns": 1,
      "url": ["http://localhost:8080/index.html"]
    },
    "assert": {
      "assertions": {
        "installable-manifest": "error",
        "service-worker": "error",
        "maskable-icon": "warn",
        "themed-omnibox": "warn",
        "viewport": "error",
        "errors-in-console": "error",
        "color-contrast": "warn"
      }
    },
    "upload": {
      "target": "filesystem",
      "outputDir": "./lighthouse-report"
    }
  }
}
