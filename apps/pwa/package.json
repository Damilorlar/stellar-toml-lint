{
  "name": "stellar-toml-lint-pwa",
  "private": true,
  "version": "0.1.0",
  "description": "Offline-first progressive web app studio for stellar-toml-lint, with IndexedDB project storage.",
  "type": "module",
  "scripts": {
    "generate:icons": "node scripts/generate-icons.mjs",
    "generate:data": "node scripts/generate-offline-data.mjs",
    "predev": "npm run generate:icons && npm run generate:data",
    "dev": "vite",
    "prebuild": "npm run generate:icons && npm run generate:data",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "preview": "vite preview --port 4173",
    "audit": "lhci autorun",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "smol-toml": "^1.7.1",
    "stellar-toml-lint": "file:../.."
  },
  "devDependencies": {
    "@lhci/cli": "^0.14.0",
    "typescript": "^5.7.2",
    "vite": "^5.4.11",
    "vite-plugin-pwa": "^0.20.5",
    "vitest": "^2.1.8"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/anchor-tools/stellar-toml-lint.git"
  },
  "license": "Apache-2.0"
}
