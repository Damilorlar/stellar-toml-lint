{
  "$comment": "Generated from the stellar-toml-lint rule registry by apps/pwa/scripts/generate-offline-data.mjs. Do not edit by hand.",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/anchor-tools/stellar-toml-lint/main/schema/stellar-toml.schema.json",
  "title": "SEP-1 stellar.toml",
  "description": "The Stellar Info File (stellar.toml) published at /.well-known/stellar.toml, as specified by SEP-1.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "VERSION": {
      "type": "string",
      "minLength": 1,
      "description": "The version of the stellar.toml schema the file adheres to."
    },
    "NETWORK_PASSPHRASE": {
      "type": "string",
      "minLength": 1,
      "description": "Passphrase of the Stellar network the file targets."
    },
    "HORIZON_URL": {
      "type": "string",
      "minLength": 1,
      "pattern": "^https://",
      "description": "URL of a Horizon instance to use with this anchor."
    },
    "ACCOUNTS": {
      "type": "string",
      "description": "Stellar account IDs or channels that indicate the accounts this anchor uses."
    },
    "URI_REQUEST_SIGNING_KEY": {
      "type": "string",
      "pattern": "^G[A-Z2-7]{55}$",
      "description": "Stellar account used to sign URI request tokens (SEP-7)."
    },
    "WEB_AUTH_ENDPOINT": {
      "type": "string",
      "minLength": 1,
      "pattern": "^https://",
      "description": "SEP-10 web authentication endpoint."
    },
    "WEB_AUTH_FOR_CONTRACTS_ENDPOINT": {
      "type": "string",
      "minLength": 1,
      "pattern": "^https://",
      "description": "SEP-45 web authentication for contracts endpoint."
    },
    "WEB_AUTH_CONTRACT_ID": {
      "type": "string",
      "minLength": 1,
      "description": "Soroban contract ID used for SEP-45 web auth."
    },
    "FEDERATION_SERVER": {
      "type": "string",
      "minLength": 1,
      "pattern": "^https://",
      "description": "SEP-2 federation endpoint."
    },
    "AUTH_SERVER": {
      "type": "string",
      "minLength": 1,
      "pattern": "^https://",
      "description": "Deprecated SEP-3 compliance endpoint."
    },
    "TRANSFER_SERVER": {
      "type": "string",
      "minLength": 1,
      "pattern": "^https://",
      "description": "SEP-6 transfer server endpoint."
    },
    "TRANSFER_SERVER_SEP0024": {
      "type": "string",
      "minLength": 1,
      "pattern": "^https://",
      "description": "SEP-24 transfer server endpoint."
    },
    "KYC_SERVER": {
      "type": "string",
      "minLength": 1,
      "pattern": "^https://",
      "description": "SEP-12 KYC endpoint."
    },
    "DIRECT_PAYMENT_SERVER": {
      "type": "string",
      "minLength": 1,
      "pattern": "^https://",
      "description": "SEP-31 direct payment server endpoint."
    },
    "ANCHOR_QUOTE_SERVER": {
      "type": "string",
      "minLength": 1,
      "pattern": "^https://",
      "description": "SEP-38 anchor quote server endpoint."
    },
    "SIGNING_KEY": {
      "type": "string",
      "pattern": "^G[A-Z2-7]{55}$",
      "description": "Stellar account used for SEP-10 challenge signatures."
    },
    "DOCUMENTATION": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "ORG_NAME": {
          "type": "string",
          "minLength": 1,
          "description": "Legal name of the organization."
        },
        "ORG_DBA": {
          "type": "string",
          "minLength": 1,
          "description": "DBA of the organization if it operates under a different name."
        },
        "ORG_URL": {
          "type": "string",
          "minLength": 1,
          "pattern": "^https://",
          "description": "Canonical URL of the organization. Must be an HTTPS URL serving the same domain."
        },
        "ORG_LOGO": {
          "type": "string",
          "minLength": 1,
          "pattern": "^https://",
          "description": "URL of an image (PNG/JPG) to be used as a logo."
        },
        "ORG_DESCRIPTION": {
          "type": "string",
          "minLength": 1,
          "description": "Short description of the organization."
        },
        "ORG_PHYSICAL_ADDRESS": {
          "type": "string",
          "minLength": 1,
          "description": "Physical address of the organization."
        },
        "ORG_PHYSICAL_ADDRESS_ATTESTATION": {
          "type": "string",
          "minLength": 1,
          "pattern": "^https://",
          "description": "URL to a photo or PDF of an official document attesting the physical address."
        },
        "ORG_PHONE_NUMBER": {
          "type": "string",
          "minLength": 1,
          "description": "Phone number of the organization."
        },
        "ORG_PHONE_NUMBER_ATTESTATION": {
          "type": "string",
          "minLength": 1,
          "pattern": "^https://",
          "description": "URL to a photo of a phone bill or similar attesting the phone number."
        },
        "ORG_KEYBASE": {
          "type": "string",
          "minLength": 1,
          "description": "Keybase account name for the organization."
        },
        "ORG_TWITTER": {
          "type": "string",
          "minLength": 1,
          "description": "Twitter/X account name of the organization."
        },
        "ORG_GITHUB": {
          "type": "string",
          "minLength": 1,
          "description": "GitHub account or organization for the organization."
        },
        "ORG_OFFICIAL_EMAIL": {
          "type": "string",
          "minLength": 1,
          "description": "Official email for organization inquiries."
        },
        "ORG_SUPPORT_EMAIL": {
          "type": "string",
          "minLength": 1,
          "description": "Support email for client support inquiries."
        },
        "ORG_LICENSING_AUTHORITY": {
          "type": "string",
          "minLength": 1,
          "description": "Name of the authority that licensed the organization."
        },
        "ORG_LICENSE_TYPE": {
          "type": "string",
          "minLength": 1,
          "description": "Type of license the organization holds."
        },
        "ORG_LICENSE_NUMBER": {
          "type": "string",
          "minLength": 1,
          "description": "Official license number."
        }
      }
    },
    "PRINCIPALS": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "description": "Full name of the principal."
          },
          "email": {
            "type": "string",
            "minLength": 1,
            "description": "Email address of the principal."
          },
          "keybase": {
            "type": "string",
            "minLength": 1,
            "description": "Keybase account name of the principal."
          },
          "telegram": {
            "type": "string",
            "minLength": 1,
            "description": "Telegram account name of the principal."
          },
          "twitter": {
            "type": "string",
            "minLength": 1,
            "description": "Twitter/X account name of the principal."
          },
          "github": {
            "type": "string",
            "minLength": 1,
            "description": "GitHub account of the principal."
          },
          "id_photo_hash": {
            "type": "string",
            "minLength": 1,
            "description": "SHA-256 hash of the photo of the principal, lowercase hex."
          },
          "verification_photo_hash": {
            "type": "string",
            "minLength": 1,
            "description": "SHA-256 hash of the verification photo of the principal, lowercase hex."
          }
        },
        "required": [
          "name",
          "email"
        ]
      },
      "description": "Primary contact persons for the organization."
    },
    "CURRENCIES": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "code": {
            "type": "string",
            "minLength": 1,
            "description": "Asset code as registered on the Stellar network."
          },
          "issuer": {
            "oneOf": [
              {
                "type": "string",
                "pattern": "^G[A-Z2-7]{55}$",
                "description": "Stellar account ID that issued the asset."
              },
              {
                "type": "null"
              }
            ]
          },
          "contract": {
            "type": "string",
            "minLength": 1,
            "description": "Soroban contract ID of the token (required for SAC tokens)."
          },
          "code_template": {
            "type": "string",
            "minLength": 1,
            "description": "Template for asset codes, using `?` as a wildcard (required for shared assets)."
          },
          "status": {
            "enum": [
              "live",
              "dead",
              "test",
              "private"
            ],
            "description": "Live status of the asset: live, dead, test, or private."
          },
          "display_decimals": {
            "type": "integer",
            "minimum": 0,
            "maximum": 7,
            "description": "Preferred number of decimal places to show to users."
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "description": "Short name of the asset."
          },
          "desc": {
            "type": "string",
            "minLength": 1,
            "description": "Description of the asset and its issuance policy."
          },
          "conditions": {
            "type": "string",
            "minLength": 1,
            "description": "Conditions of issuance."
          },
          "image": {
            "type": "string",
            "minLength": 1,
            "pattern": "^https://",
            "description": "URL of an image representing the asset."
          },
          "fixed_number": {
            "type": "integer",
            "minimum": 0,
            "description": "Fixed number of tokens issued."
          },
          "max_number": {
            "type": "integer",
            "minimum": 0,
            "description": "Maximum number of tokens issued."
          },
          "is_unlimited": {
            "type": "boolean",
            "description": "Whether the token can have unlimited issuance."
          },
          "is_asset_anchored": {
            "type": "boolean",
            "description": "Whether the asset is anchored to an asset outside the Stellar network."
          },
          "anchor_asset_type": {
            "enum": [
              "fiat",
              "crypto",
              "stock",
              "bond",
              "commodity",
              "real_estate",
              "other"
            ],
            "description": "Type of asset anchored: fiat, crypto, stock, bond, commodity, real_estate, or other."
          },
          "anchor_asset": {
            "type": "string",
            "minLength": 1,
            "description": "Symbol of the asset that backs this one."
          },
          "attestation_of_reserve": {
            "type": "string",
            "minLength": 1,
            "pattern": "^https://",
            "description": "URL attesting the reserve backing the asset."
          },
          "redemption_instructions": {
            "type": "string",
            "minLength": 1,
            "description": "Instructions to redeem the asset."
          },
          "collateral_addresses": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Addresses holding reserves for the asset."
          },
          "collateral_address_messages": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Messages attesting the collateral addresses."
          },
          "collateral_address_signatures": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Signatures attesting the collateral addresses."
          },
          "regulated": {
            "type": "boolean",
            "description": "Whether the asset is regulated (SEP-8)."
          },
          "approval_server": {
            "type": "string",
            "minLength": 1,
            "pattern": "^https://",
            "description": "SEP-8 approval service endpoint for the asset."
          },
          "approval_criteria": {
            "type": "string",
            "minLength": 1,
            "description": "SEP-8 criteria the asset must meet for approval."
          },
          "toml": {
            "type": "string",
            "minLength": 1,
            "pattern": "^https://",
            "description": "URL of the stellar.toml for a shared asset."
          }
        },
        "required": [
          "code"
        ]
      },
      "description": "Assets issued by this anchor."
    },
    "VALIDATORS": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "ALIAS": {
            "type": "string",
            "minLength": 1,
            "description": "A name to uniquely identify the validator."
          },
          "DISPLAY_NAME": {
            "type": "string",
            "minLength": 1,
            "description": "A human-readable name for display purposes."
          },
          "PUBLIC_KEY": {
            "type": "string",
            "pattern": "^G[A-Z2-7]{55}$",
            "description": "The Stellar account associated with the validator."
          },
          "HOST": {
            "type": "string",
            "minLength": 1,
            "description": "Fully qualified domain name plus port of the validator."
          },
          "HISTORY": {
            "type": "string",
            "minLength": 1,
            "pattern": "^https://",
            "description": "URL of the history archive for the validator."
          }
        },
        "required": [
          "ALIAS",
          "PUBLIC_KEY",
          "HOST"
        ]
      },
      "description": "Validator nodes run by this organization."
    }
  }
}
