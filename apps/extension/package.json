{
  "name": "stellar-toml-lint-extension",
  "private": true,
  "version": "0.1.0",
  "description": "WebExtension (Manifest V3) that auto-detects and lints the stellar.toml served by the site you are visiting.",
  "type": "module",
  "scripts": {
    "generate:icons": "node scripts/generate-icons.mjs",
    "build": "npm run generate:icons && node build.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.0",
    "esbuild": "^0.21.5",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/anchor-tools/stellar-toml-lint.git"
  },
  "license": "Apache-2.0"
}
